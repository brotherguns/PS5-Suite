<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.manos.ps5suite</ApplicationId>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>7.2.4</ApplicationDisplayVersion>
    <ApplicationTitle>PS5 Suite</ApplicationTitle>
    <!-- Unsigned IPA: no Apple Developer account needed.
         CI passes /p:BuildIpa=true with code signing disabled and
         packages the .app into Payload/*.ipa (TrollStore/Sideloadly). -->
    <IpaPackageName>PS5Suite</IpaPackageName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PS5SuiteAndroid\PS5SuiteAndroid.csproj" />
  </ItemGroup>
</Project>
